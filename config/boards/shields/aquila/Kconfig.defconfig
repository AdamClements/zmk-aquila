if SHIELD_AQUILA_LEFT

config ZMK_KEYBOARD_NAME
        default "Aquila"

# The left half (with the working OLED) is the central: display widgets
# for layer and output status only run on the central, so the screen half
# must own that role to show more than battery status.
config ZMK_SPLIT_ROLE_CENTRAL
        default y

endif

if SHIELD_AQUILA_LEFT || SHIELD_AQUILA_RIGHT

config ZMK_SPLIT
        default y

endif
