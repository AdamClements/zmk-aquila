#include "aquila.dtsi"

&default_transform {
	col-offset = <19>;
};

/* The right half has the OLED on the accessory connector, not an encoder.
 * The encoder pins (P0.04/P0.06) are the i2c bus here — leaving the EC11
 * devices enabled would read i2c traffic as phantom rotations. */
&encoder_1 {
	status = "disabled";
};

&encoder_2 {
	status = "disabled";
};

/* Mirrored PCB: on right halves the accessory connector lands on
 * P1.04/P1.06 (the 2022 sda-pin=36/scl-pin=38 config that worked on
 * this half), unlike left halves where it is P0.04/P0.06. */
&pro_micro_i2c_alt_default {
	group1 {
		psels = <NRF_PSEL(TWIM_SDA, 1, 4)>, <NRF_PSEL(TWIM_SCL, 1, 6)>;
	};
};

&pro_micro_i2c_alt_sleep {
	group1 {
		psels = <NRF_PSEL(TWIM_SDA, 1, 4)>, <NRF_PSEL(TWIM_SCL, 1, 6)>;
		low-power-enable;
	};
};
