#include "aquila.dtsi"

&default_transform {
	col-offset = <19>;
};

/* The right half has the OLED on the accessory connector, not an encoder.
 * The encoder pins (P0.04/P0.06) are the i2c bus here — leaving the EC11
 * devices enabled would read i2c traffic as phantom rotations. */
&encoder_1 {
	status = "disabled";
};

&encoder_2 {
	status = "disabled";
};

/* Mirrored PCB: the accessory connector's two data lines swap sides
 * relative to the left half, so SDA/SCL are crossed here. */
&pro_micro_i2c_alt_default {
	group1 {
		psels = <NRF_PSEL(TWIM_SDA, 0, 6)>, <NRF_PSEL(TWIM_SCL, 0, 4)>;
	};
};

&pro_micro_i2c_alt_sleep {
	group1 {
		psels = <NRF_PSEL(TWIM_SDA, 0, 6)>, <NRF_PSEL(TWIM_SCL, 0, 4)>;
		low-power-enable;
	};
};
