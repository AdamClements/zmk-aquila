#include "aquila.dtsi"

&default_transform {
	col-offset = <19>;
};

/* The right half has the OLED on the accessory connector, not an encoder.
 * The encoder pins (P0.04/P0.06) are the i2c bus here — leaving the EC11
 * devices enabled would read i2c traffic as phantom rotations. */
&encoder_1 {
	status = "disabled";
};

&encoder_2 {
	status = "disabled";
};

/* This half's OLED module is strapped to i2c address 0x3D (the left
 * spare's module answers at the default 0x3C). */
&oled {
	reg = <0x3d>;
};
